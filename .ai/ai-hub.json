{
  "version": 1,
  "targets": {
    ".claude": {
      "rules": {
        "ext": ".md",
        "frontmatter": "preamble"
      },
      "overlay": "targets/claude",
      "exclude": [
        "README.md"
      ],
      "preserve": [
        "settings.local.json",
        "scheduled_tasks.lock"
      ]
    },
    ".cursor": {
      "rules": {
        "ext": ".mdc",
        "frontmatter": "keep"
      },
      "overlay": "targets/cursor",
      "selfPath": ".cursor/",
      "selfPathKeep": [
        ".claude/agents/"
      ],
      "exclude": [
        "agents/**",
        "README.md"
      ],
      "skillRenames": {
        "md-to-wiki": "wikis"
      },
      "replace": [
        {
          "from": "[CLAUDE.md § 1.3 Git and GitHub](../../CLAUDE.md) and [CLAUDE.md § 1.4 PR review read-only](../../CLAUDE.md)",
          "to": "[git-github.mdc](../../rules/git-github.mdc) and [pr-review-readonly.mdc](../../rules/pr-review-readonly.mdc)"
        },
        {
          "from": "[CLAUDE.md § 1.3 Git and GitHub](../../CLAUDE.md)",
          "to": "[git-github.mdc](../../rules/git-github.mdc)"
        },
        {
          "from": "[writing-style-rafael](../../rules/writing-style-rafael.md)",
          "to": "[writing-style-rafael.mdc](../../rules/writing-style-rafael.mdc)"
        },
        {
          "from": "| `CLAUDE.md` § 1.1 |",
          "to": "| `ai-context.mdc` |"
        },
        {
          "from": "| `CLAUDE.md` § 1.2 |",
          "to": "| `security-secrets.mdc` |"
        },
        {
          "from": "| `CLAUDE.md` § 1.3 |",
          "to": "| `git-github.mdc` |"
        },
        {
          "from": "| `CLAUDE.md` § 1.4 |",
          "to": "| `pr-review-readonly.mdc` |"
        },
        {
          "from": "(`CLAUDE.md` § 1.1)",
          "to": "(`ai-context.mdc`)"
        },
        {
          "from": "`CLAUDE.md` § 1.2",
          "to": "`security-secrets.mdc`"
        },
        {
          "from": "`CLAUDE.md` § 1.3",
          "to": "`git-github.mdc`"
        },
        {
          "from": "`CLAUDE.md` § 1.4",
          "to": "`pr-review-readonly.mdc`"
        },
        {
          "from": "`.claude/rules/writing-style-rafael.md`",
          "to": "`writing-style-rafael.mdc`"
        },
        {
          "from": "`.claude/rules/ai-development-workflow.md`",
          "to": "`ai-development-workflow.mdc`"
        },
        {
          "from": "`.claude/rules/stack-vieira-front.md`",
          "to": "`stack-vieira-front.mdc`"
        },
        {
          "from": "`.claude/rules/new-task-readonly.md`",
          "to": "`new-task-readonly.mdc`"
        },
        {
          "from": ".claude/rules/ai-development-workflow.md",
          "to": "ai-development-workflow.mdc"
        },
        {
          "from": ".claude/skills/md-to-wiki",
          "to": ".claude/skills/wikis"
        },
        {
          "from": "`Toolbox` (tools `mcp__Toolbox__*`)",
          "to": "`user-Toolbox`"
        },
        {
          "from": "`mcp__Toolbox__*` tools",
          "to": "`CallMcpTool` / Toolbox `execute`"
        },
        {
          "from": "MCP GitHub (Toolbox)",
          "to": "MCP GitHub (user-Toolbox)"
        },
        {
          "from": "`stitch` (tools `mcp__stitch__*`)",
          "to": "`user-stitch`"
        },
        {
          "from": "`WebFetch` to download the HTML code",
          "to": "`web_fetch` or `read_url_content` to download the HTML code"
        },
        {
          "from": "  - \"mcp__shadcn__*\"",
          "to": "  - \"shadcn*:*\"\n  - \"mcp_shadcn*\""
        },
        {
          "from": "\"mcp__chrome-devtools__*\"",
          "to": "\"chrome*:*\""
        },
        {
          "from": "\"mcp__remotion__*\"",
          "to": "\"remotion*:*\""
        },
        {
          "from": "mcp__stitch__*",
          "to": "stitch*:*"
        },
        {
          "from": "WebFetch",
          "to": "web_fetch"
        },
        {
          "from": "AskUserQuestion",
          "to": "Question"
        }
      ]
    },
    ".opencode": {
      "extends": ".cursor",
      "overlay": "targets/opencode",
      "selfPath": ".opencode/"
    }
  }
}
