.env

ofx
ofx/*

# Notion one-shot dump (PII / histórico pessoal)
backend/scripts/data/*.json
!backend/scripts/data/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# allow vendor SDK dist (root + frontend copy)
!vendor/vieira-analytics/dist/
!vendor/vieira-analytics/dist/**
!frontend/vendor/vieira-analytics/dist/
!frontend/vendor/vieira-analytics/dist/**
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
versions/*
out/*

# Issues
.issues
.issues/*

